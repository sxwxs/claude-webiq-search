{
  "name": "claude-webiq-search",
  "version": "0.1.0",
  "description": "Lightweight Microsoft Web IQ search plugin for Claude Code",
  "type": "module",
  "license": "MIT",
  "author": "sxwxs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxwxs/claude-webiq-search.git"
  },
  "homepage": "https://github.com/sxwxs/claude-webiq-search#readme",
  "bugs": "https://github.com/sxwxs/claude-webiq-search/issues",
  "keywords": [
    "claude-code-plugin",
    "mcp",
    "web-search",
    "webiq",
    "ghc-api"
  ],
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
